{
  "listen_host": "127.0.0.1",
  "listen_port": 8788,
  "path": "/github",
  "shipbraid_url": "http://127.0.0.1:8787",
  "timeout_seconds": 10,
  "secret_env": "SHIPBRAID_GITHUB_WEBHOOK_SECRET",
  "routes": [
    {
      "id": "example-app-main-v1",
      "repository_id": 123456789,
      "ref": "refs/heads/main",
      "lane_id": "example-test",
      "components": ["app"],
      "token_env": "SHIPBRAID_GITHUB_TEST_TOKEN"
    }
  ]
}
